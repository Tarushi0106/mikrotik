# Copy this file to .env and fill in your device details.
#   cp .env.example .env
# .env is gitignored because it holds the router admin password.

# ── Router connection ─────────────────────────────────────────────────────────
# Factory default is 192.168.88.1. If you don't know the IP, use WinBox and look
# at the Neighbors tab — it discovers routers over Layer 2 without a valid IP.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=

# auto   = try REST (v7) first, fall back to the binary API (v6)   [default]
# rest   = force RouterOS v7 REST
# binary = force the binary API, port 8728 — required for RouterOS v6
MIKROTIK_API=auto

# ── REST transport (RouterOS v7 only) ─────────────────────────────────────────
# Enable on the router first:  /ip service enable www-ssl
MIKROTIK_REST_PROTOCOL=https
# Leave blank for the protocol default (443 for https, 80 for http).
MIKROTIK_REST_PORT=
# RouterOS ships a self-signed certificate, so verification is off by default.
# Set to true only once you have installed a trusted certificate on the device.
MIKROTIK_TLS_VERIFY=false

# ── Binary transport (RouterOS v6 and v7) ─────────────────────────────────────
# Enable on the router first:  /ip service enable api
MIKROTIK_BINARY_PORT=8728

MIKROTIK_TIMEOUT_MS=8000

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=4000
SESSION_TTL_MINUTES=480

# router = sign-in credentials are verified against RouterOS itself
# bypass = accept any credentials, so you can use the UI with mock data
#          Set this when the router is unreachable or you want to demo the UI.
AUTH_MODE=bypass

# ── Dashboard traffic chart ───────────────────────────────────────────────────
# RouterOS keeps no queryable traffic history, so the backend polls the byte
# counters and builds the history itself. It starts empty and fills as it runs.
# Blank = automatically track the busiest running non-bridge interface.
TRAFFIC_INTERFACE=
TRAFFIC_INTERVAL_MS=10000
TRAFFIC_HISTORY_POINTS=60
